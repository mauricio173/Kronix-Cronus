NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Gere com npm run db:init. Nunca compartilhe o .env real.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Defina true somente se estiver atrás de proxy reverso confiável.
TRUST_PROXY=false
BACKUP_DIR=server/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Credenciais privadas de API somente no servidor.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
PICPAY_CLIENT_ID=
PICPAY_CLIENT_SECRET=
PICPAY_WEBHOOK_TOKEN=
PICPAY_API_BASE_URL=https://api.picpay.com/ecommerce/public/v1
ENABLE_TEST_PIX=true

