{
  "name": "kronix-store",
  "version": "1.0.0",
  "private": true,
  "description": "Backend da Kronix Store com painel de aprovação e conectores de fornecedores",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node server/init-admin.js",
    "backup": "node server/run-backup.js",
    "test": "node --test",
    "restore": "node server/restore-backup.js"
  },
  "engines": {
    "node": ">=22 <24"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  }
}
